{
	"name": "token-types",
	"version": "6.1.2",
	"description": "Common token types for decoding and encoding numeric and string values",
	"author": {
		"name": "Borewit",
		"url": "https://github.com/Borewit"
	},
	"funding": {
		"type": "github",
		"url": "https://github.com/sponsors/Borewit"
	},
	"scripts": {
		"clean": "del-cli 'lib/**/*.js' 'lib/**/*.js.map' 'lib/**/*.d.ts' 'test/**/*.js' 'test/**/*.js.map' 'test/**/*.d.ts' 'index.js' 'index.js.map' coverage",
		"build": "npm run clean && npm run compile",
		"prepublishOnly": "npm run build",
		"compile-src": "tsc --p lib",
		"compile-test": "tsc --p test",
		"compile": "npm run compile-src && npm run compile-test",
		"lint:ts": "biome check",
		"lint:md": "remark -u preset-lint-recommended .",
		"lint": "npm run lint:md && npm run lint:ts",
		"test": "mocha",
		"test-coverage": "c8 npm run test:compiled",
		"update-biome": "yarn add -D --exact @biomejs/biome && npx @biomejs/biome migrate --write",
		"test:compiled": "mocha --no-config \"test/*.js\""
	},
	"engines": {
		"node": ">=14.16"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Borewit/token-types.git"
	},
	"files": [
		"lib/index.js",
		"lib/index.d.ts"
	],
	"license": "MIT",
	"type": "module",
	"exports": "./lib/index.js",
	"types": "lib/index.d.ts",
	"bugs": {
		"url": "https://github.com/Borewit/token-types/issues"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.6",
		"@types/chai": "^5.2.3",
		"@types/mocha": "^10.0.10",
		"@types/node": "^25.3.5",
		"c8": "^11.0.0",
		"chai": "^6.2.2",
		"del-cli": "^7.0.0",
		"mocha": "^11.7.6",
		"remark-cli": "^12.0.1",
		"remark-preset-lint-recommended": "^7.0.0",
		"source-map-support": "^0.5.21",
		"ts-node": "^10.9.1",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"@borewit/text-codec": "^0.2.2",
		"@tokenizer/token": "^0.3.0",
		"ieee754": "^1.2.1"
	},
	"remarkConfig": {
		"plugins": [
			"preset-lint-recommended"
		]
	},
	"keywords": [
		"token",
		"integer",
		"unsigned",
		"numeric",
		"float",
		"IEEE",
		"754",
		"strtok3"
	],
	"packageManager": "yarn@4.9.2"
}
